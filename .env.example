# LabTrail - AI Research Knowledge & Experiment Workspace

# seekdb configuration (document storage + hybrid search)
SEEKDB_MODE=embedded
# Optional: override the embedded database directory
# SEEKDB_PATH=./data/seekdb
# For server mode:
# SEEKDB_MODE=server
# SEEKDB_HOST=localhost
# SEEKDB_PORT=2881

# PowerContext Server (research memory)
POWERCONTEXT_URL=http://127.0.0.1:8890
# Directory used by the local `powercontext server run` process
POWERCONTEXT_HOME=./backend/data/powercontext

# Embedding model: pyseekdb bundles all-MiniLM-L6-v2 (384 dims, local ONNX)

# LLM configuration (optional)
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Server configuration
HOST=0.0.0.0
PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
